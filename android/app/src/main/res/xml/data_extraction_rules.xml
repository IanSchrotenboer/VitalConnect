<?xml version="1.0" encoding="utf-8"?>
<!-- Niets meenemen naar een cloudback-up of een nieuw toestel: de inlogsleutels horen bij dit toestel
     en de gezondheidsdata staat al veilig in je account. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
